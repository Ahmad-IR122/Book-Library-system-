@model BookLibrary.Models.Book

<div class="container mt-5">
    <h1>➕ Add New Book</h1>

    <form asp-action="Create" method="post" class="mt-4">
        <div class="mb-3">
            <label asp-for="Title" class="form-label">Title *</label>
            <input asp-for="Title" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Author" class="form-label">Author *</label>
            <input asp-for="Author" class="form-control" required />
        </div>

        <div class="mb-3">
            <label asp-for="Genre" class="form-label">Genre</label>
            <input asp-for="Genre" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="ISBN" class="form-label">ISBN</label>
            <input asp-for="ISBN" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Price</label>
            <input asp-for="Price" type="number" step="0.01" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Quantity" class="form-label">Quantity</label>
            <input asp-for="Quantity" type="number" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="PublishedDate" class="form-label">Published Date</label>
            <input asp-for="PublishedDate" type="date" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        </div>

        <button type="submit" class="btn btn-success">Create</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>